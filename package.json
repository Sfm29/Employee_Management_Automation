{
  "name": "orangehrm_automation",
  "version": "1.0.0",
  "description": "End-to-end UI and API automation framework built with Playwright and TypeScript.",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --grep @ui",
    "test:api": "playwright test --grep @api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure": "npm run allure:generate && npm run allure:open"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "qa",
    "api",
    "ui",
    "orangehrm"
  ],
  "author": "",
  "license": "ISC",
  "directories": {
    "test": "tests"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "playwright": "^1.61.1",
    "playwright-core": "^1.61.1",
    "undici-types": "^8.3.0"
  }
}